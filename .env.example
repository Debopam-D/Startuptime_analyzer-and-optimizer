# Environment variables for Startup Analyzer

# Application discovery
# Paths to search for applications
APPS_SEARCH_PATHS=/Applications;/System/Applications;~/.local;~/Applications

# Measurement settings
STARTUP_ANALYZER_ITERATIONS=5
STARTUP_ANALYZER_COOLDOWN=3.0
STARTUP_ANALYZER_CPU_IDLE_THRESHOLD=3.0
STARTUP_ANALYZER_CPU_IDLE_DURATION=3.0
STARTUP_ANALYZER_WINDOW_TIMEOUT=60.0
STARTUP_ANALYZER_IDLE_TIMEOUT=120.0
STARTUP_ANALYZER_SAMPLE_INTERVAL=0.05

# Output settings
STARTUP_ANALYZER_OUTPUT_FORMAT=html
STARTUP_ANALYZER_INCLUDE_CHARTS=true

# Logging
STARTUP_ANALYZER_LOG_LEVEL=INFO
STARTUP_ANALYZER_LOG_FILE=startup_analyzer.log

# Platform-specific
# macOS
# STARTUP_ANALYZER_MOUNT_POINTS=/Applications;/System/Applications

# Linux
# STARTUP_ANALYZER_DESKTOP_DIRS=/usr/share/applications;~/.local/share/applications

# Windows
# STARTUP_ANALYZER_REGISTRY_PATHS=HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\App Paths